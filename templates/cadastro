<!-- Outras seções simplificadas para o exemplo -->
<section class="section" id="regras">
    <div class="section-header"><h2>Regulamento</h2></div>
    <div class="rules-grid">
        <div class="rule-box"><h3>Agendamento</h3><p>Mínimo de 48h de antecedência pelo sistema.</p></div>
        <div class="rule-box"><h3>Uso Consciente</h3><p>Zelar pelos equipamentos e manter a limpeza.</p></div>
    </div>
</section>

<section class="section" id="agendamento">
  <div class="section-header"><h2>Solicitar Uso</h2></div>
  <div class="form-container">
    <div class="grid-2col">
        <div style="display:flex; flex-direction:column; gap:8px;">
            <label>Nome</label>
            <input type="text" id="nomeInput" style="padding:12px; border:1px solid var(--border); border-radius:8px;">
        </div>
        <div>
        <label for="objetoInput">Objeto de Uso</label>
        <br>
        <textarea id="objetoInput" style="padding:12px;     border:1px solid var(--border); border-radius:8px; width: 100%; height: 30vh; resize: vertical;"></textarea>
        </div>
        <div style="display:flex; flex-direction:column; gap:8px;">
            <label>Data</label>
            <input type="date" id="dataInput" style="padding:12px; border:1px solid var(--border); border-radius:8px;">
        </div>
    </div>
    <button class="btn-primary" style="margin-top:20px; width:100%;" onclick="submitBooking()">Enviar Solicitação</button>
  </div>
</section>

<div id="toast">Mensagem aqui</div>

<script>
function toggleMenu() {
  document.getElementById('navLinks').classList.toggle('open');
}

function showSection(id) {
  document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.nav-links a').forEach(a => a.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  const navItem = document.getElementById('nav-' + id);
  if(navItem) navItem.classList.add('active');
  
  // Fecha menu mobile ao clicar
  document.getElementById('navLinks').classList.remove('open');
  window.scrollTo(0, 0);
}

function submitBooking() {
  const nome = document.getElementById('nomeInput').value;
  if(!nome) {
    showToast("❌ Preencha seu nome!");
    return;
  }
  showToast("✅ Solicitação enviada com sucesso!");
}

function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 3000);
}
</script>

