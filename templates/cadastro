<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>IFMAKER & LAB 4.0 — IFAL Marechal Deodoro</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --primary: #16a34a;
    --primary-hover: #15803d;
    --primary-light: #dcfce7;
    --secondary: #2563eb;
    --secondary-light: #dbeafe;
    --bg-color: #f8fafc;
    --surface: #ffffff;
    --text-main: #0f172a;
    --text-muted: #64748b;
    --border: #e2e8f0;
    --radius-md: 8px;
    --radius-lg: 12px;
    --font-sans: 'Inter', sans-serif;
    --font-mono: 'JetBrains Mono', monospace;
    --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }

  body {
    background: var(--bg-color);
    color: var(--text-main);
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.6;
    overflow-x: hidden;
  }

  /* ===== NAV RESPONSIVO ===== */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    padding: 0 5%;
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; min-width: max-content; }
  .logo-badge { background: var(--primary); color: white; font-weight: 700; font-size: 11px; padding: 4px 8px; border-radius: 4px; }
  .logo-text { font-weight: 700; font-size: 16px; color: var(--text-main); }

  /* Menu Mobile Icon */
  .menu-toggle { display: none; background: none; border: none; font-size: 24px; cursor: pointer; color: var(--text-main); }

  .nav-links { display: flex; align-items: center; gap: 5px; list-style: none; }
  .nav-links a {
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 500;
    font-size: 14px;
    padding: 8px 12px;
    border-radius: var(--radius-md);
    transition: 0.2s;
    white-space: nowrap;
  }
  .nav-links a:hover, .nav-links a.active { color: var(--primary); background: var(--primary-light); }
  .trello-btn { background: #0052CC !important; color: white !important; }

  /* ===== LAYOUT GERAL ===== */
  .section {
    display: none;
    padding: 100px 5% 60px;
    max-width: 1200px;
    margin: 0 auto;
    min-height: 100vh;
  }
  .section.active { display: block; animation: fadeIn 0.4s ease-out; }

  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

  .section-header h2 { font-size: clamp(24px, 5vw, 36px); font-weight: 700; margin-bottom: 10px; }

  /* ===== HERO (HOME) ===== */
  .hero {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 40px;
    align-items: center;
    margin-bottom: 60px;
  }
  .hero h1 { font-size: clamp(32px, 6vw, 56px); font-weight: 800; line-height: 1.1; margin-bottom: 20px; }
  .hero h1 span { color: var(--primary); }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }

  /* ===== GRIDS RESPONSIVOS ===== */
  .labs-grid, .rules-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
    margin-top: 40px;
  }

  .lab-card, .rule-box {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 30px;
    height: 100%;
  }

  /* ===== ESCALA (O DESAFIO DO MOBILE) ===== */
  .schedule-wrapper {
    overflow-x: auto; /* Permite rolar a tabela no celular */
    margin-top: 20px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
  }

  .schedule-grid {
    display: grid;
    grid-template-columns: 100px repeat(5, 200px); /* Largura mínima para não esmagar */
    background: var(--border);
    gap: 1px;
  }

  .sg-header, .sg-shift { background: #f1f5f9; padding: 15px; font-weight: 600; text-align: center; font-size: 13px; }
  .sg-cell { background: var(--surface); padding: 10px; display: flex; flex-direction: column; gap: 5px; min-height: 120px; }
  
  .monitor-chip {
    display: flex; align-items: center; gap: 6px;
    background: var(--primary-light); color: var(--primary-hover);
    padding: 5px 8px; border-radius: 6px; font-size: 11px; font-weight: 600;
  }
  .monitor-chip.voluntario { background: var(--secondary-light); color: var(--secondary); }
  .monitor-avatar { width: 20px; height: 20px; background: var(--primary); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 9px; }
  .voluntario .monitor-avatar { background: var(--secondary); }

  /* ===== FORMULÁRIO ===== */
  .form-container {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: clamp(20px, 5vw, 40px);
    max-width: 850px;
  }
  .grid-2col { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .equip-selector { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 10px; }
  
  .btn-primary, .btn-secondary {
    padding: 12px 24px; border-radius: var(--radius-md); font-weight: 600; cursor: pointer; border: none; transition: 0.2s;
    text-align: center;
  }
  .btn-primary { background: var(--primary); color: white; }
  .btn-secondary { background: white; border: 1px solid var(--border); }

  /* ===== TOAST ===== */
  #toast {
    position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%) translateY(100px);
    background: #1e293b; color: white; padding: 12px 24px; border-radius: 50px;
    z-index: 2000; transition: 0.3s; opacity: 0; text-align: center; width: max-content; max-width: 90vw;
  }
  #toast.show { transform: translateX(-50%) translateY(0); opacity: 1; }

  /* ===== MEDIA QUERIES (O CORAÇÃO DA RESPONSIVIDADE) ===== */
  @media (max-width: 992px) {
    .hero { grid-template-columns: 1fr; text-align: center; }
    .hero-desc { margin: 0 auto 30px; }
    .hero-actions { justify-content: center; }
  }

  @media (max-width: 768px) {
    .menu-toggle { display: block; }
    .nav-links {
      position: absolute; top: 70px; left: 0; right: 0;
      background: white; flex-direction: column; padding: 20px;
      border-bottom: 1px solid var(--border);
      display: none; /* Escondido por padrão no mobile */
    }
    .nav-links.open { display: flex; }
    .nav-links li { width: 100%; }
    .nav-links a { display: block; width: 100%; text-align: center; padding: 15px; }
    
    .grid-2col { grid-template-columns: 1fr; }
    .section { padding-top: 90px; }
  }

  @media (max-width: 480px) {
    .logo-text { font-size: 14px; }
    .hero h1 { font-size: 32px; }
    .lab-card { padding: 20px; }
  }
</style>
</head>
<body>

<nav>
